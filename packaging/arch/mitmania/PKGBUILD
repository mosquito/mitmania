# Maintainer: Dmitry Orlov <orlovdl@gmail.com>

pkgname=mitmania
pkgver=0.4.0
pkgrel=1
pkgdesc="Distributed, fail-closed policy and interception proxy"
arch=('x86_64' 'aarch64')
url="https://docs.mitmania.com/"
license=('custom:Hippocratic')
depends=('ca-certificates' 'systemd')
makedepends=('go>=1.26')
backup=('etc/mitmania.conf')
options=('!debug' '!strip')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mosquito/mitmania/archive/refs/tags/v${pkgver}.tar.gz"
        "mitmania.service"
        "mitmania.conf")
sha256sums=('8b55749872b4be60e03cd5af86b4c5ea68ee522b91cf90128e5a71d3c4324a4a'
            '08065a0c53e7995f39569ae0a8a13155a79defaaae91f71da6d8aa6be9ab643e'
            '83a31548ca173a4c1230dbc6d6f149a025e88a4e0c0273f0d136f44d0fa1d579')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -ldflags "-w -s -X main.version=v${pkgver} -buildid= -extldflags=static" \
		-buildvcs=false -trimpath -o mitmania ./cmd/mitmania
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 mitmania "$pkgdir/usr/bin/mitmania"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$srcdir/mitmania.service" "$pkgdir/usr/lib/systemd/system/mitmania.service"
	install -Dm600 "$srcdir/mitmania.conf" "$pkgdir/etc/mitmania.conf"
}
